<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<AssemblyName>AmmoBalance</AssemblyName>
		<Version>3.2.0</Version>
		<LangVersion>7.3</LangVersion>
		<Platforms>AnyCPU;x64</Platforms>
		<ReferencesPath Condition="'$(ReferencesPath)' == ''">$(MSBuildThisFileDirectory)REFERENCES</ReferencesPath>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="tests/**/*.cs" />
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
		<Reference Include="Assembly-CSharp">
			<HintPath>$(ReferencesPath)/Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp-firstpass">
			<HintPath>$(ReferencesPath)/Assembly-CSharp-firstpass.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Exiled.API">
			<HintPath>$(ReferencesPath)/Exiled.API.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Exiled.Events">
			<HintPath>$(ReferencesPath)/Exiled.Events.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NorthwoodLib">
			<HintPath>$(ReferencesPath)/NorthwoodLib.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ReferencesPath)/UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
